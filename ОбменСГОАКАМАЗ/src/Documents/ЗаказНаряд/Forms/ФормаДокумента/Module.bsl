#Область СлужебныеПроцедурыИФункции

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ГОА_НастроитьПолеСостояния(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Поле = Элементы.Найти("Состояние");
	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поле.ПутьКДанным = "ГОА_ОтображаемаяСтадия";
	Поле.РежимВыбораИзСписка = Истина;
	Поле.КнопкаОчистки = Ложь;
	Поле.СписокВыбора.Очистить();
	Для Каждого Стадия Из Перечисления.ГОА_СтадииЗаказНаряда Цикл
		Поле.СписокВыбора.Добавить(Стадия);
	КонецЦикла;

	ГОА_ОбновитьОтображаемуюСтадию();

КонецПроцедуры

&НаСервере
&Перед("СостояниеПриИзмененииНаСервере")
Процедура ГОА_СостояниеПриИзмененииНаСервере(ПараметрыДействия = Неопределено)

	Поле = Элементы.Найти("Состояние");
	Если Поле = Неопределено Или Поле.ПутьКДанным <> "ГОА_ОтображаемаяСтадия" Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ГОА_ОтображаемаяСтадия) Тогда
		ГОА_ДанныеЗаказНаряда.ПрименитьСтадию(Объект, ГОА_ОтображаемаяСтадия);
		Модифицированность = Истина;
	Иначе
		ГОА_ОбновитьОтображаемуюСтадию();
	КонецЕсли;

КонецПроцедуры

&НаСервере
&После("УправлениеДиалогомНаСервере")
Процедура ГОА_ОбновитьОтображаемуюСтадию()

	ГОА_ОтображаемаяСтадия = ГОА_ДанныеЗаказНаряда.СтадияЗаказНаряда(
		Объект.Состояние, Объект.ГОА_Стадия, Объект.ГОА_Местонахождение);

КонецПроцедуры

#КонецОбласти
