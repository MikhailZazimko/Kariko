#Область ПрограммныйИнтерфейс

// Возвращает данные заказ-наряда для формирования XML ГОА.
//
// Параметры:
//  ЗаказНаряд - ДокументСсылка.ЗаказНаряд, ДокументОбъект.ЗаказНаряд - записанный заказ-наряд.
//
// Возвращаемое значение:
//  Структура - даты, стадия, местонахождение, пометка удаления и данные Driver.
//   * ArrivalDate - Дата - фактические дата и время заезда.
//   * CompletionDate - Дата - дата окончания работ.
//   * DepartureDate - Дата - дата закрытия заказ-наряда.
//   * AcceptanceAct - Дата, Неопределено - фактическая дата выезда.
//   * Stage - Число, Неопределено - код стадии ГОА.
//   * VehicleLocation - Число - код местонахождения техники.
//   * PostTroubleshootingVehicleDepartureDate - Дата, Неопределено - дата выезда после дефектовки.
//   * RepairStartDate - Дата, Неопределено - дата начала ремонта после получения запчастей.
//   * Driver - Структура - сведения из карточки заказчика.
//    ** Name - Строка - ФИО или наименование заказчика.
//    ** Phone - Строка - телефон из контактной информации заказчика.
//    ** Post - Строка - должность заказчика.
//   * Deleted - Булево - пометка удаления заказ-наряда.
Функция ДанныеДляВыгрузки(ЗаказНаряд) Экспорт

	Стадия = СтадияЗаказНаряда(ЗаказНаряд.Состояние, ЗаказНаряд.ГОА_Стадия);
	ТехникаУПотребителя = МестонахождениеДляСтадии(Стадия)
		= Перечисления.ГОА_МестонахождениеАвтотехники.УПотребителя;
	Данные = Новый Структура;
	Данные.Вставить("ArrivalDate", ЗаказНаряд.ГОА_ДатаФактическогоЗаезда);
	Данные.Вставить("CompletionDate", ЗаказНаряд.ДатаОкончания);
	Данные.Вставить("DepartureDate", ЗаказНаряд.ДатаЗакрытия);
	Данные.Вставить("AcceptanceAct", ЗаполненнаяДата(ЗаказНаряд.ГОА_ДатаФактическогоВыезда));
	Данные.Вставить("Stage", КодСтадии(Стадия));
	Данные.Вставить("VehicleLocation", ?(ТехникаУПотребителя, 1, 0));
	Данные.Вставить("PostTroubleshootingVehicleDepartureDate", Неопределено);
	Данные.Вставить("RepairStartDate", Неопределено);
	Данные.Вставить("Driver", ДанныеВодителя(ЗаказНаряд.СводныйРемонтныйЗаказ.Заказчик));
	Данные.Вставить("Deleted", ЗаказНаряд.ПометкаУдаления);

	Если ТехникаУПотребителя Тогда
		Данные.PostTroubleshootingVehicleDepartureDate = ЗаполненнаяДата(
			ЗаказНаряд.ГОА_ДатаВыездаПослеДефектовки);
		Данные.RepairStartDate = ЗаполненнаяДата(ЗаказНаряд.ГОА_ДатаНачалаРемонтаПослеПолученияЗапчастей);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Определяет стадию для поля «Состояние» и для выгрузки.
//
// Параметры:
//  ШтатноеСостояние - СправочникСсылка.ВидыСостоянийЗаказНарядов - состояние Альфа-Авто.
//  СохраненнаяСтадия - ПеречислениеСсылка.ГОА_СтадииЗаказНаряда - уточнение этапа ремонта.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ГОА_СтадииЗаказНаряда - стадия с учетом штатного состояния.
Функция СтадияЗаказНаряда(ШтатноеСостояние, СохраненнаяСтадия) Экспорт

	Состояния = Справочники.ВидыСостоянийЗаказНарядов;
	Стадии = Перечисления.ГОА_СтадииЗаказНаряда;

	Если ШтатноеСостояние = Состояния.Закрыт Тогда
		Возврат Стадии.Закрыт;
	КонецЕсли;

	Если ШтатноеСостояние = Состояния.Выполнен Тогда
		Возврат ?(СохраненнаяСтадия = Стадии.ПереданаЗаказчику, СохраненнаяСтадия, Стадии.РаботыЗавершены);
	КонецЕсли;

	Если ШтатноеСостояние = Состояния.Заявка Или ШтатноеСостояние = Состояния.НачатьРаботу
		Или Не ЗначениеЗаполнено(ШтатноеСостояние) Тогда
		Возврат Стадии.ОжиданиеЗаездаВРемзону;
	КонецЕсли;

	Если СохраненнаяСтадия = Стадии.ОжиданиеЗапчастейУПотребителя
		Или СохраненнаяСтадия = Стадии.ОжиданиеЗапчастейНаТерритории
		Или СохраненнаяСтадия = Стадии.ОжиданиеСогласования
		Или СохраненнаяСтадия = Стадии.Диагностика Тогда
		Возврат СохраненнаяСтадия;
	КонецЕсли;

	Возврат ?(ШтатноеСостояние = Состояния.ВРаботе, Стадии.ВРаботе, Стадии.ПустаяСсылка());

КонецФункции

// Определяет местонахождение автотехники по стадии заказ-наряда.
//
// Параметры:
//  Стадия - ПеречислениеСсылка.ГОА_СтадииЗаказНаряда - действующая стадия.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ГОА_МестонахождениеАвтотехники - местонахождение автотехники.
Функция МестонахождениеДляСтадии(Стадия) Экспорт

	Стадии = Перечисления.ГОА_СтадииЗаказНаряда;
	Местонахождения = Перечисления.ГОА_МестонахождениеАвтотехники;
	Если Стадия = Стадии.ОжиданиеЗаездаВРемзону
		Или Стадия = Стадии.ПереданаЗаказчику
		Или Стадия = Стадии.Закрыт Тогда
		Возврат Местонахождения.УПотребителя;
	КонецЕсли;

	Возврат Местонахождения.ВСервисномЦентре;

КонецФункции

// Переносит выбранную стадию в данные ЗН перед штатным обработчиком поля «Состояние».
//
// Параметры:
//  ЗаказНаряд - ДанныеФормыСтруктура - данные документа в форме заказ-наряда.
//  Стадия - ПеречислениеСсылка.ГОА_СтадииЗаказНаряда - выбранная пользователем стадия.
Процедура ПрименитьСтадию(ЗаказНаряд, Стадия) Экспорт

	ЗаказНаряд.ГОА_Стадия = Стадия;
	ЗаказНаряд.Состояние = ШтатноеСостояниеДляСтадии(Стадия, ЗаказНаряд.Состояние);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Сохраняет вычисленное местонахождение перед записью заказ-наряда.
//
// Параметры:
//  Источник - ДокументОбъект.ЗаказНаряд - записываемый заказ-наряд.
//  Отказ - Булево - признак отмены записи.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи заказ-наряда.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения заказ-наряда.
Процедура ПередЗаписьюЗаказНаряда(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Стадия = СтадияЗаказНаряда(Источник.Состояние, Источник.ГОА_Стадия);
	Источник.ГОА_Местонахождение = МестонахождениеДляСтадии(Стадия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеВодителя(Заказчик)

	Данные = Новый Структура("Name, Phone, Post", "", "", "");
	Если ТипЗнч(Заказчик) <> Тип("СправочникСсылка.Контрагенты") Или Не ЗначениеЗаполнено(Заказчик) Тогда
		Возврат Данные;
	КонецЕсли;

	Карточка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказчик, "НаименованиеПолное, Наименование, Должность");
	Данные.Name = ?(ЗначениеЗаполнено(Карточка.НаименованиеПолное), Карточка.НаименованиеПолное, Карточка.Наименование);
	Данные.Phone = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, ТекущаяДатаСеанса());
	ЦифрыТелефона = УправлениеКонтактнойИнформациейКлиентСервер.ОставитьТолькоЦифрыВСтроке(Данные.Phone);
	Если СтрДлина(ЦифрыТелефона) = 11 Тогда
		Данные.Phone = ЦифрыТелефона;
	КонецЕсли;
	Если ЗначениеЗаполнено(Карточка.Должность) Тогда
		Данные.Post = Строка(Карточка.Должность);
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ШтатноеСостояниеДляСтадии(Стадия, ТекущееСостояние)

	Состояния = Справочники.ВидыСостоянийЗаказНарядов;
	Стадии = Перечисления.ГОА_СтадииЗаказНаряда;

	Если Стадия = Стадии.Закрыт Тогда
		Возврат Состояния.Закрыт;
	КонецЕсли;

	Если Стадия = Стадии.РаботыЗавершены Или Стадия = Стадии.ПереданаЗаказчику Тогда
		Возврат Состояния.Выполнен;
	КонецЕсли;

	Если Стадия = Стадии.ОжиданиеЗаездаВРемзону Тогда
		Возврат ?(ТекущееСостояние = Состояния.Заявка Или Не ЗначениеЗаполнено(ТекущееСостояние),
			Состояния.Заявка, Состояния.НачатьРаботу);
	КонецЕсли;

	Возврат Состояния.ВРаботе;

КонецФункции

Функция КодСтадии(Стадия)

	Стадии = Перечисления.ГОА_СтадииЗаказНаряда;
	КодыСтадий = Новый Соответствие;
	КодыСтадий.Вставить(Стадии.ПереданаЗаказчику, 1);
	КодыСтадий.Вставить(Стадии.Закрыт, 2);
	КодыСтадий.Вставить(Стадии.РаботыЗавершены, 3);
	КодыСтадий.Вставить(Стадии.ОжиданиеЗапчастейУПотребителя, 4);
	КодыСтадий.Вставить(Стадии.ОжиданиеЗапчастейНаТерритории, 5);
	КодыСтадий.Вставить(Стадии.ОжиданиеСогласования, 6);
	КодыСтадий.Вставить(Стадии.ВРаботе, 7);
	КодыСтадий.Вставить(Стадии.Диагностика, 8);
	КодыСтадий.Вставить(Стадии.ОжиданиеЗаездаВРемзону, 9);
	Возврат КодыСтадий.Получить(Стадия);

КонецФункции

Функция ЗаполненнаяДата(Знач ДатаСобытия)

	Возврат ?(ЗначениеЗаполнено(ДатаСобытия), ДатаСобытия, Неопределено);

КонецФункции

#КонецОбласти
