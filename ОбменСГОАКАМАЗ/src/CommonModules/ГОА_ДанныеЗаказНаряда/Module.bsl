#Область ПрограммныйИнтерфейс

// Возвращает данные заказ-наряда для формирования XML ГОА.
//
// Параметры:
//  ЗаказНаряд - ДокументСсылка.ЗаказНаряд - записанный заказ-наряд.
//
// Возвращаемое значение:
//  Структура - даты, стадия, местонахождение, пометка удаления и данные Driver.
//   * ArrivalDate - Дата - фактические дата и время заезда.
//   * CompletionDate - Дата - дата окончания работ.
//   * DepartureDate - Дата - дата закрытия заказ-наряда.
//   * AcceptanceAct - Дата, Неопределено - фактическая дата выезда.
//   * Stage - Число, Неопределено - код стадии ГОА.
//   * VehicleLocation - Число, Неопределено - код местонахождения техники.
//   * PostTroubleshootingVehicleDepartureDate - Дата, Неопределено - дата выезда после дефектовки.
//   * RepairStartDate - Дата, Неопределено - дата начала ремонта после получения запчастей.
//   * Driver - Структура - сведения из карточки заказчика.
//    ** Name - Строка - ФИО или наименование заказчика.
//    ** Phone - Строка - телефон из контактной информации заказчика.
//    ** Post - Строка - должность заказчика.
//   * Deleted - Булево - пометка удаления заказ-наряда.
Функция ДанныеДляВыгрузки(ЗаказНаряд) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказНаряд,
		"Состояние, ГОА_Стадия, ГОА_ДатаФактическогоЗаезда, ГОА_ДатаФактическогоВыезда, ГОА_Местонахождение, "
		+ "ГОА_ДатаВыездаПослеДефектовки, ГОА_ДатаНачалаРемонтаПослеПолученияЗапчастей, "
		+ "ДатаОкончания, ДатаЗакрытия, ПометкаУдаления, СводныйРемонтныйЗаказ.Заказчик");

	Местонахождение = КодМестонахождения(Реквизиты.ГОА_Местонахождение, Реквизиты.ГОА_Стадия);
	Данные = Новый Структура;
	Данные.Вставить("ArrivalDate", Реквизиты.ГОА_ДатаФактическогоЗаезда);
	Данные.Вставить("CompletionDate", Реквизиты.ДатаОкончания);
	Данные.Вставить("DepartureDate", Реквизиты.ДатаЗакрытия);
	Данные.Вставить("AcceptanceAct", ЗаполненнаяДата(Реквизиты.ГОА_ДатаФактическогоВыезда));
	Данные.Вставить("Stage", КодСтадии(Реквизиты.Состояние, Реквизиты.ГОА_Стадия, Местонахождение));
	Данные.Вставить("VehicleLocation", Местонахождение);
	Данные.Вставить("PostTroubleshootingVehicleDepartureDate", Неопределено);
	Данные.Вставить("RepairStartDate", Неопределено);
	Данные.Вставить("Driver", ДанныеВодителя(Реквизиты.СводныйРемонтныйЗаказЗаказчик));
	Данные.Вставить("Deleted", Реквизиты.ПометкаУдаления);

	Если Местонахождение = 1 Тогда
		Данные.PostTroubleshootingVehicleDepartureDate = ЗаполненнаяДата(
			Реквизиты.ГОА_ДатаВыездаПослеДефектовки);
		Данные.RepairStartDate = ЗаполненнаяДата(Реквизиты.ГОА_ДатаНачалаРемонтаПослеПолученияЗапчастей);
	КонецЕсли;

	Возврат Данные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеВодителя(Заказчик)

	Данные = Новый Структура("Name, Phone, Post", "", "", "");
	Если ТипЗнч(Заказчик) <> Тип("СправочникСсылка.Контрагенты") Или Не ЗначениеЗаполнено(Заказчик) Тогда
		Возврат Данные;
	КонецЕсли;

	Карточка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказчик, "НаименованиеПолное, Наименование, Должность");
	Данные.Name = ?(ЗначениеЗаполнено(Карточка.НаименованиеПолное), Карточка.НаименованиеПолное, Карточка.Наименование);
	Данные.Phone = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	Если ЗначениеЗаполнено(Карточка.Должность) Тогда
		Данные.Post = Строка(Карточка.Должность);
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция КодСтадии(ШтатноеСостояние, СтадияГОА, Местонахождение)

	Состояния = Справочники.ВидыСостоянийЗаказНарядов;
	Стадии = Перечисления.ГОА_СтадииЗаказНаряда;

	Если ШтатноеСостояние = Состояния.Закрыт Тогда
		Возврат 2;
	КонецЕсли;

	Если СтадияГОА = Стадии.ПереданаЗаказчику Тогда
		Возврат 1;
	КонецЕсли;

	Если ШтатноеСостояние = Состояния.Выполнен Тогда
		Возврат 3;
	КонецЕсли;

	Если СтадияГОА = Стадии.ОжиданиеЗапчастейУПотребителя
		Или СтадияГОА = Стадии.ОжиданиеЗапчастейНаТерритории Тогда
		Возврат ?(Местонахождение = 1, 4, 5);
	КонецЕсли;

	КодыСтадий = Новый Соответствие;
	КодыСтадий.Вставить(Стадии.ОжиданиеСогласования, 6);
	КодыСтадий.Вставить(Стадии.ВРаботе, 7);
	КодыСтадий.Вставить(Стадии.Диагностика, 8);
	КодыСтадий.Вставить(Стадии.ОжиданиеЗаездаВРемзону, 9);
	Код = КодыСтадий.Получить(СтадияГОА);
	Если Код <> Неопределено Тогда
		Возврат Код;
	КонецЕсли;

	Возврат ?(ШтатноеСостояние = Состояния.ВРаботе, 7, Неопределено);

КонецФункции

Функция КодМестонахождения(Местонахождение, СтадияГОА)

	ВариантыМестонахождения = Перечисления.ГОА_МестонахождениеАвтотехники;
	Если Местонахождение = ВариантыМестонахождения.ВСервисномЦентре Тогда
		Возврат 0;
	КонецЕсли;

	Если Местонахождение = ВариантыМестонахождения.УПотребителя Тогда
		Возврат 1;
	КонецЕсли;

	Стадии = Перечисления.ГОА_СтадииЗаказНаряда;
	Если СтадияГОА = Стадии.ОжиданиеЗапчастейНаТерритории Тогда
		Возврат 0;
	КонецЕсли;

	Если СтадияГОА = Стадии.ОжиданиеЗапчастейУПотребителя Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЗаполненнаяДата(Знач ДатаСобытия)

	Возврат ?(ЗначениеЗаполнено(ДатаСобытия), ДатаСобытия, Неопределено);

КонецФункции

#КонецОбласти
