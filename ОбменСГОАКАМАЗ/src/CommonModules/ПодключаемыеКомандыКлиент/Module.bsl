#Область СлужебныеПроцедурыИФункции

&Вместо("НачатьВыполнениеКоманды")
Процедура ГОА_НачатьВыполнениеКоманды(Форма, Команда, Знач Источник = Неопределено)

	Если Форма.ИмяФормы = "Документ.ЗаказНаряд.Форма.ФормаДокумента"
		И ТипЗнч(Команда) = Тип("ПолеФормы")
		И Команда.Имя = "ГОА_ПолеСостояния" Тогда
		// Форма продолжает обработку оповещения на сервере в своем контексте.
		Форма.Подключаемый_ОбработкаРезультатаОповещения(Новый Структура, "ГОА_ВыборСтадии");
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Форма, Команда, Источник);

КонецПроцедуры

#КонецОбласти
