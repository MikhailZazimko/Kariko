#Область СлужебныеПроцедурыИФункции

&Вместо("НачатьВыполнениеКоманды")
Процедура ГОА_НачатьВыполнениеКоманды(Форма, Команда, Знач Источник = Неопределено)

	Если Форма.ИмяФормы = "Документ.ЗаказНаряд.Форма.ФормаДокумента"
		И ТипЗнч(Команда) = Тип("ПолеФормы")
		И Команда.Имя = "ГОА_ПолеСостояния" Тогда
		// Форма продолжает обработку оповещения на сервере в своем контексте.
		Форма.Подключаемый_ОбработкаРезультатаОповещения(Новый Структура, "ГОА_ВыборСтадии");
		Возврат;
	КонецЕсли;

	Если Форма.ИмяФормы = "Документ.ЗаказНаряд.Форма.ФормаДокумента"
		И ТипЗнч(Команда) = Тип("КомандаФормы")
		И Команда.Имя = "ГОА_СформироватьXML" Тогда
		ГОА_СохранитьXML(Форма);
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Форма, Команда, Источник);

КонецПроцедуры

Процедура ГОА_СохранитьXML(Форма)

	ЗаказНаряд = Форма.Объект.Ссылка;
	Если Не ЗначениеЗаполнено(ЗаказНаряд) Или Форма.Модифицированность Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Запишите заказ-наряд перед формированием XML.'"));
		Возврат;
	КонецЕсли;

	ФайлXML = ГОА_ВыгрузкаЗаказНарядаВызовСервера.СформироватьФайл(ЗаказНаряд, Форма.УникальныйИдентификатор);
	Если ФайлXML = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Заголовок = НСтр("ru = 'Сохранение XML для ГОА'");
	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов(Заголовок, Истина);
	НачатьПолучениеФайлаССервера(ФайлXML.Адрес, ФайлXML.ИмяФайла, ПараметрыДиалога);

КонецПроцедуры

#КонецОбласти
