#Область ПрограммныйИнтерфейс

// Формирует XML одного записанного заказ-наряда для сохранения на компьютере пользователя.
//
// Параметры:
//  ЗаказНаряд - ДокументСсылка.ЗаказНаряд - заказ-наряд для выгрузки.
//  ИдентификаторФормы - УникальныйИдентификатор - владелец данных во временном хранилище.
//
// Возвращаемое значение:
//  Структура - данные для скачивания файла:
//   * Адрес - Строка - адрес файла во временном хранилище.
//   * ИмяФайла - Строка - предлагаемое имя файла.
//  Неопределено - отсутствует дата заезда.
Функция СформироватьФайл(ЗаказНаряд, ИдентификаторФормы) Экспорт

	Если ТипЗнч(ЗаказНаряд) <> Тип("ДокументСсылка.ЗаказНаряд") Или Не ЗначениеЗаполнено(ЗаказНаряд) Тогда
		ВызватьИсключение НСтр("ru = 'Для формирования XML нужен записанный заказ-наряд.'");
	КонецЕсли;

	ДокументЗаказНаряд = ЗаказНаряд.ПолучитьОбъект();
	Если ДокументЗаказНаряд = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Заказ-наряд не найден.'");
	КонецЕсли;

	ДанныеГОА = ГОА_ДанныеЗаказНаряда.ДанныеДляВыгрузки(ДокументЗаказНаряд);
	Если Не ЗначениеЗаполнено(ДанныеГОА.ArrivalDate) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Заполните дату фактического заезда и запишите заказ-наряд.'"));
		Возврат Неопределено;
	КонецЕсли;

	ДанныеШапки = ДанныеШапкиЗаказНаряда(ДокументЗаказНаряд);
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("JobOrders");
	ЗаписатьЗаказНаряд(Запись, ДокументЗаказНаряд, ДанныеШапки, ДанныеГОА);
	Запись.ЗаписатьКонецЭлемента();

	Файл = ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, Ложь);
	Адрес = ПоместитьВоВременноеХранилище(Файл, ИдентификаторФормы);
	ИмяФайла = "GOA-" + Строка(ЗаказНаряд.УникальныйИдентификатор()) + ".xml";
	Возврат Новый Структура("Адрес, ИмяФайла", Адрес, ИмяФайла);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеШапкиЗаказНаряда(ЗаказНаряд)

	СводныйЗаказ = ЗаказНаряд.СводныйРемонтныйЗаказ;
	Заказчик = СводныйЗаказ.Заказчик;
	Автомобиль = СводныйЗаказ.Автомобиль;
	Организация = ЗаказНаряд.Организация;
	ДатаЗаказа = ЗаказНаряд.Дата;

	Шапка = Новый Структура;
	Шапка.Вставить("Vehicle", ДанныеАвтотехники(Автомобиль));
	КПП = Справочники.Организации.КППНаДату(Организация, ДатаЗаказа);
	Шапка.Вставить("Executor", Новый Структура("INN, KPP, Name", Организация.ИНН, КПП, Строка(Организация)));
	Шапка.Вставить("Customer", ДанныеСтороны(Заказчик, ДатаЗаказа));
	Владелец = Неопределено;
	ГосНомер = "";
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		ВидыСведений = Перечисления.ДополнительнаяИнформацияАвтомобилей;
		Владелец = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, ВидыСведений.Хозяин);
		РегистрационныйНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(
			Автомобиль, ВидыСведений.ГосНомер, ДатаЗаказа);
		ГосНомер = СтрЗаменить(Строка(РегистрационныйНомер), " ", "");
	КонецЕсли;
	Шапка.Вставить("Owner", ДанныеСтороны(Владелец, ТекущаяДатаСеанса()));
	Шапка.Вставить("SLP", ГосНомер);

	ВидРемонта = ЗаказНаряд.ВидРемонта;
	Ремонт = Строка(ВидРемонта);
	Шапка.Вставить("Repair", Ремонт);
	Если Ремонт = "Гарантийный ремонт" Тогда
		Операция = "Гарантийный";
	ИначеЕсли ВидРемонта.ТипРемонта = Перечисления.ТипыРемонта.Платный Тогда
		Операция = "Коммерческий";
	Иначе
		Операция = "";
	КонецЕсли;
	Шапка.Вставить("Operation", Операция);

	Согласие = Неопределено;
	Если ЗначениеЗаполнено(Заказчик) И ЗначениеЗаполнено(Организация) Тогда
		Согласие = ЗащитаПерсональныхДанных.ДействующееСогласиеНаОбработкуПерсональныхДанных(
			Заказчик, Организация, КонецДня(ТекущаяДатаСеанса()));
	КонецЕсли;
	Шапка.Вставить("PersonalInfo", Согласие <> Неопределено);

	Возврат Шапка;

КонецФункции

Функция ДанныеАвтотехники(Автомобиль)

	ДлинаVIN = 17;
	VIN = СокрЛП(Автомобиль.ОригинальныйVIN);
	Если СтрДлина(VIN) <> ДлинаVIN Тогда
		VIN = СокрЛП(Автомобиль.VIN);
	КонецЕсли;

	НомерШасси = Прав(?(СтрДлина(VIN) = ДлинаVIN, VIN, СокрЛП(Автомобиль.НомерШасси)), 7);
	Возврат Новый Структура("VINShassis, NumberShassis, NumberEngine", VIN, НомерШасси, Автомобиль.НомерДвигателя);

КонецФункции

Функция ДанныеСтороны(Сторона, ДатаСведений)

	Данные = Новый Структура("INN, KPP, Name, Address", "", "", "", "");
	Если Не ЗначениеЗаполнено(Сторона) Тогда
		Возврат Данные;
	КонецЕсли;

	ТипСтороны = ТипЗнч(Сторона);
	ВидыКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации;
	Если ТипСтороны = Тип("СправочникСсылка.Организации") Тогда
		Данные.KPP = Справочники.Организации.КППНаДату(Сторона, ДатаСведений);
		ВидАдреса = ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	ИначеЕсли ТипСтороны = Тип("СправочникСсылка.Контрагенты") Тогда
		Данные.KPP = Справочники.Контрагенты.КППНаДату(Сторона, ДатаСведений);
		ВидАдреса = ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
	Иначе
		Возврат Данные;
	КонецЕсли;

	Данные.INN = Сторона.ИНН;
	Данные.Name = ?(ПустаяСтрока(Сторона.НаименованиеПолное), Сторона.Наименование, Сторона.НаименованиеПолное);
	Данные.Address = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Сторона, ВидАдреса, ДатаСведений);
	Возврат Данные;

КонецФункции

Функция ПричинаОбращенияДляВыгрузки(ЗаказНаряд)

	Описание = СокрЛП(ЗаказНаряд.ОписаниеПричиныОбращения);
	Если ПустаяСтрока(Описание) Тогда
		Причины = Новый Массив;
		Для Каждого Причина Из ЗаказНаряд.ПричиныОбращения Цикл
			ТекстПричины = СокрЛП(Причина.ПричинаОбращенияСодержание);
			Если Не ПустаяСтрока(ТекстПричины) Тогда
				Причины.Добавить(ТекстПричины);
			КонецЕсли;
		КонецЦикла;
		Описание = СтрСоединить(Причины, "; ");
	КонецЕсли;

	Возврат Лев(Описание, 50);

КонецФункции

Процедура ЗаписатьЗаказНаряд(Запись, ЗаказНаряд, Шапка, ДанныеГОА)

	Запись.ЗаписатьНачалоЭлемента("JobOrder");
	ЗаписатьПоле(Запись, "Number", ЗаказНаряд.Номер);
	ЗаписатьПоле(Запись, "Date", ЗаказНаряд.Дата);
	ЗаписатьГруппуПолей(Запись, "Vehicle", Шапка.Vehicle);
	ЗаписатьГруппуПолей(Запись, "Executor", Шапка.Executor);
	ЗаписатьГруппуПолей(Запись, "Customer", Шапка.Customer);
	ЗаписатьГруппуПолей(Запись, "Owner", Шапка.Owner);
	ЗаписатьГруппуПолей(Запись, "Driver", ДанныеГОА.Driver);
	ЗаписатьГруппуПолей(Запись, "Charge", Новый Структура("Name, Phone, Post", "", "", ""));
	ЗаписатьПоле(Запись, "Payment", "");
	ЗаписатьПоле(Запись, "Operation", Шапка.Operation);
	ЗаписатьПоле(Запись, "StandardHour", 0);
	ЗаписатьПоле(Запись, "Currency", ЗаказНаряд.ВалютаДокумента.Код);
	ЗаписатьПоле(Запись, "ArrivalDate", ДанныеГОА.ArrivalDate);
	ЗаписатьПоле(Запись, "CompletionDate", ДанныеГОА.CompletionDate);
	ЗаписатьПоле(Запись, "DepartureDate", ДанныеГОА.DepartureDate);
	ЗаписатьПоле(Запись, "Mileage", ЗаказНаряд.Пробег);
	ЗаписатьПоле(Запись, "RunningTime", 0);
	ЗаписатьПоле(Запись, "Repair", Шапка.Repair);
	ЗаписатьПоле(Запись, "Reason", ПричинаОбращенияДляВыгрузки(ЗаказНаряд));
	ЗаписатьПоле(Запись, "AdditionalWork", Лев(ЗаказНаряд.Рекомендации, 300));
	ЗаписатьПоле(Запись, "RepeatDate", Дата(1, 1, 1));
	ЗаписатьПоле(Запись, "PostService", Ложь);
	ЗаписатьПоле(Запись, "PersonalInfo", Шапка.PersonalInfo);
	ЗаписатьПоле(Запись, "Comment", Лев(ЗаказНаряд.Комментарий, 80));
	ЗаписатьПоле(Запись, "User", Строка(ЗаказНаряд.Автор));

	ЗаписатьРаботы(Запись, ЗаказНаряд.Автоработы);
	ЗаписатьТовары(Запись, ЗаказНаряд.Товары);
	ЗаписатьМатериалы(Запись, ЗаказНаряд.МатериалыЗаказчика);

	НДСРабот = ЗаказНаряд.Автоработы.Итог("СуммаНДС");
	НДСТоваров = ЗаказНаряд.Товары.Итог("СуммаНДС");
	СуммаРабот = ЗаказНаряд.Автоработы.Итог("СуммаВсего");
	СуммаТоваров = ЗаказНаряд.Товары.Итог("СуммаВсего");
	ЗаписатьПоле(Запись, "SumWork", СуммаРабот - НДСРабот);
	ЗаписатьПоле(Запись, "SumProduct", СуммаТоваров - НДСТоваров);
	ЗаписатьПоле(Запись, "SumVAT", НДСРабот + НДСТоваров);
	ЗаписатьПоле(Запись, "SumTotal", СуммаРабот + СуммаТоваров);

	Если Шапка.Repair = "Предпродажная подготовка" Тогда
		ЗаписатьПоле(Запись, "TypePSP", "ППП");
	КонецЕсли;
	ЗаписатьПоле(Запись, "Stage", ДанныеГОА.Stage);
	ЗаписатьПоле(Запись, "SLP", Шапка.SLP);
	ЗаписатьПоле(Запись, "Deleted", ДанныеГОА.Deleted);
	ЗаписатьПоле(Запись, "RepairStartDate", ДанныеГОА.RepairStartDate);
	ЗаписатьПоле(Запись, "PostTroubleshootingVehicleDepartureDate", ДанныеГОА.PostTroubleshootingVehicleDepartureDate);
	ЗаписатьПоле(Запись, "AcceptanceAct", ДанныеГОА.AcceptanceAct);
	ЗаписатьПоле(Запись, "VehicleLocation", ДанныеГОА.VehicleLocation);
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьРаботы(Запись, Работы)

	Запись.ЗаписатьНачалоЭлемента("Works");
	Для Каждого Работа Из Работы Цикл
		Запись.ЗаписатьНачалоЭлемента("Work");
		ЗаписатьПоле(Запись, "Operations", Строка(Работа.Авторабота));
		ЗаписатьПоле(Запись, "OperationCode", "99999");
		ЗаписатьПоле(Запись, "KAMAZ", "");
		ЗаписатьПоле(Запись, "Price", Работа.Цена);
		ЗаписатьПоле(Запись, "Amount", Работа.Количество);
		ЗаписатьПоле(Запись, "Sum", Работа.СуммаВсего - Работа.СуммаНДС);
		ЗаписатьПоле(Запись, "Workload", Работа.Коэффициент * Работа.Количество);
		ЗаписатьПоле(Запись, "OperationWorkload", Работа.Коэффициент);
		ЗаписатьПоле(Запись, "Discount", Работа.ПроцентСкидки);
		ЗаписатьПоле(Запись, "SumVAT", Работа.СуммаНДС);
		ЗаписатьПоле(Запись, "SumTotal", Работа.СуммаВсего);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьТовары(Запись, Товары)

	Запись.ЗаписатьНачалоЭлемента("Products");
	Для Каждого Товар Из Товары Цикл
		Артикул = СокрЛП(Товар.Номенклатура.Артикул);
		Запись.ЗаписатьНачалоЭлемента("Product");
		ЗаписатьПоле(Запись, "Nomenclature", Строка(Товар.Номенклатура));
		ЗаписатьПоле(Запись, "Drawing", Артикул);
		ЗаписатьПоле(Запись, "KAMAZ", Артикул);
		ЗаписатьПоле(Запись, "Amount", Товар.Количество);
		ЗаписатьПоле(Запись, "Measure", Строка(Товар.ЕдиницаИзмерения));
		ЗаписатьПоле(Запись, "Price", Товар.Цена);
		ЗаписатьПоле(Запись, "Sum", Товар.СуммаВсего - Товар.СуммаНДС);
		ЗаписатьПоле(Запись, "SumVAT", Товар.СуммаНДС);
		ЗаписатьПоле(Запись, "SumTotal", Товар.СуммаВсего);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьМатериалы(Запись, Материалы)

	Запись.ЗаписатьНачалоЭлемента("Materials");
	Для Каждого Материал Из Материалы Цикл
		Запись.ЗаписатьНачалоЭлемента("Material");
		ЗаписатьПоле(Запись, "Nomenclature", Строка(Материал.Номенклатура));
		ЗаписатьПоле(Запись, "KAMAZ", СокрЛП(Материал.Номенклатура.Артикул));
		ЗаписатьПоле(Запись, "Amount", Материал.Количество);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьГруппуПолей(Запись, ИмяГруппы, Поля)

	Запись.ЗаписатьНачалоЭлемента(ИмяГруппы);
	Для Каждого Поле Из Поля Цикл
		ЗаписатьПоле(Запись, Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьПоле(Запись, ИмяПоля, Значение)

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись.ЗаписатьНачалоЭлемента(ИмяПоля);
	Запись.ЗаписатьТекст(XMLСтрока(Значение));
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

#КонецОбласти
