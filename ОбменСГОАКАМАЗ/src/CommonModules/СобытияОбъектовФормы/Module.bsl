#Область СлужебныеПроцедурыИФункции

&После("ПриСозданииНаСервере_ФормаДокумента")
Процедура ГОА_ДобавитьДанныеЗаказНаряда(Форма, Отказ, СтандартнаяОбработка)

	Если Отказ Или Форма.ИмяФормы <> "Документ.ЗаказНаряд.Форма.ФормаДокумента" Тогда
		Возврат;
	КонецЕсли;

	ГОА_НастроитьПолеСостояния(Форма);
	ГОА_ДобавитьКомандуВыгрузки(Форма);

	ЭлементыФормы = Форма.Элементы;
	ОсновнаяСтраница = ЭлементыФормы.Найти("СтраницаОсновныеРеквизиты");
	Если ОсновнаяСтраница = Неопределено Или ЭлементыФормы.Найти("ГОА_Даты") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ШтатныеДаты = ЭлементыФормы.Найти("ГруппаВременныеРамки");
	РодительГруппыДат = ?(ШтатныеДаты = Неопределено, ОсновнаяСтраница, ШтатныеДаты.Родитель);
	ГруппаДатГОА = ЭлементыФормы.Добавить("ГОА_Даты", Тип("ГруппаФормы"), РодительГруппыДат);
	ГруппаДатГОА.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаДатГОА.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаДатГОА.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГОА_ДобавитьПоля(ЭлементыФормы, ГруппаДатГОА,
		"ГОА_ДатаФактическогоЗаезда,ГОА_ДатаФактическогоВыезда,"
		+ "ГОА_ДатаВыездаПослеДефектовки,ГОА_ДатаНачалаРемонтаПослеПолученияЗапчастей");

КонецПроцедуры

Процедура ГОА_ДобавитьКомандуВыгрузки(Форма)

	Если Форма.Команды.Найти("ГОА_СформироватьXML") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Команда = Форма.Команды.Добавить("ГОА_СформироватьXML");
	Команда.Заголовок = НСтр("ru = 'Сформировать XML для ГОА'");
	Команда.Действие = "Подключаемый_ВыполнитьКоманду";

	Кнопка = Форма.Элементы.Добавить("ГОА_КнопкаСформироватьXML", Тип("КнопкаФормы"), Форма.КоманднаяПанель);
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	Кнопка.ИмяКоманды = Команда.Имя;
	Кнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;

КонецПроцедуры

Процедура ГОА_НастроитьПолеСостояния(Форма)

	ИмяРеквизитаСтадии = "ГОА_ОтображаемаяСтадия";
	ИмяРеквизитаМестонахождения = "ГОА_ОтображаемоеМестонахождение";
	ШтатноеПоле = Форма.Элементы.Найти("Состояние");
	Если ШтатноеПоле = Неопределено Или Форма.Элементы.Найти("ГОА_ПолеСостояния") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипСтадии = Новый ОписаниеТипов("ПеречислениеСсылка.ГОА_СтадииЗаказНаряда");
	РеквизитСтадии = Новый РеквизитФормы(ИмяРеквизитаСтадии, ТипСтадии);
	ТипМестонахождения = Новый ОписаниеТипов("ПеречислениеСсылка.ГОА_МестонахождениеАвтотехники");
	РеквизитМестонахождения = Новый РеквизитФормы(ИмяРеквизитаМестонахождения, ТипМестонахождения);
	РеквизитыФормы = Новый Массив;
	РеквизитыФормы.Добавить(РеквизитСтадии);
	РеквизитыФормы.Добавить(РеквизитМестонахождения);
	Форма.ИзменитьРеквизиты(РеквизитыФормы);
	Форма.ГОА_ОтображаемаяСтадия = ГОА_ДанныеЗаказНаряда.СтадияЗаказНаряда(
		Форма.Объект.Состояние, Форма.Объект.ГОА_Стадия);
	Форма.ГОА_ОтображаемоеМестонахождение = ГОА_ДанныеЗаказНаряда.МестонахождениеДляСтадии(
		Форма.ГОА_ОтображаемаяСтадия);

	Поле = Форма.Элементы.Вставить("ГОА_ПолеСостояния", Тип("ПолеФормы"), ШтатноеПоле.Родитель, ШтатноеПоле);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ИмяРеквизитаСтадии;
	ЗаполнитьЗначенияСвойств(Поле, ШтатноеПоле,
		"Заголовок,ПоложениеЗаголовка,РастягиватьПоГоризонтали,Доступность,ТолькоПросмотр,Видимость");
	Поле.РежимВыбораИзСписка = Истина;
	Поле.КнопкаВыпадающегоСписка = Истина;
	Поле.КнопкаВыбора = Ложь;
	Поле.КнопкаОчистки = Ложь;
	Поле.РедактированиеТекста = Ложь;
	Для Каждого Стадия Из Перечисления.ГОА_СтадииЗаказНаряда Цикл
		Поле.СписокВыбора.Добавить(Стадия);
	КонецЦикла;
	Поле.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьКоманду");
	ШтатноеПоле.Видимость = Ложь;

	ПолеМестонахождения = Форма.Элементы.Вставить("ГОА_Местонахождение",
		Тип("ПолеФормы"), ШтатноеПоле.Родитель, ШтатноеПоле);
	ПолеМестонахождения.Вид = ВидПоляФормы.ПолеВвода;
	ПолеМестонахождения.ПутьКДанным = ИмяРеквизитаМестонахождения;
	ПолеМестонахождения.Заголовок = НСтр("ru = 'Местонахождение автотехники'");
	ПолеМестонахождения.ТолькоПросмотр = Истина;

КонецПроцедуры

Процедура ГОА_ДобавитьПоля(ЭлементыФормы, Группа, ИменаРеквизитов)

	Для Каждого ИмяРеквизита Из СтрРазделить(ИменаРеквизитов, ",") Цикл
		Поле = ЭлементыФормы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Группа);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = "Объект." + ИмяРеквизита;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
