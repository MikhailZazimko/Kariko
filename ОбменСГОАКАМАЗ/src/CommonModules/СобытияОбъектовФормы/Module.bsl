#Область СлужебныеПроцедурыИФункции

&После("ПриСозданииНаСервере_ФормаДокумента")
Процедура ГОА_ДобавитьДанныеЗаказНаряда(Форма, Отказ, СтандартнаяОбработка)

	Если Отказ Или Форма.ИмяФормы <> "Документ.ЗаказНаряд.Форма.ФормаДокумента" Тогда
		Возврат;
	КонецЕсли;

	Страницы = Форма.Элементы.Найти("Страницы");
	Если Страницы = Неопределено Или Форма.Элементы.Найти("ГОА_Данные") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Страница = Форма.Элементы.Добавить("ГОА_Данные", Тип("ГруппаФормы"), Страницы);
	Страница.Вид = ВидГруппыФормы.Страница;
	Страница.Заголовок = НСтр("ru = 'Данные для ГОА'");
	Страница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	РеквизитыГОА = Новый Массив;
	РеквизитыГОА.Добавить("ГОА_Стадия");
	РеквизитыГОА.Добавить("ГОА_ДатаФактическогоЗаезда");
	РеквизитыГОА.Добавить("ГОА_ДатаФактическогоВыезда");
	РеквизитыГОА.Добавить("ГОА_Местонахождение");
	РеквизитыГОА.Добавить("ГОА_ДатаВыездаПослеДефектовки");
	РеквизитыГОА.Добавить("ГОА_ДатаНачалаРемонтаПослеПолученияЗапчастей");

	Для Каждого ИмяРеквизита Из РеквизитыГОА Цикл
		Поле = Форма.Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Страница);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = "Объект." + ИмяРеквизита;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
