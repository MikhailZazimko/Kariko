#Область СлужебныеПроцедурыИФункции

&Вместо("ОбработкаРезультатаОповещения")
Функция ГОА_ОбработкаРезультатаОповещения(Форма, РезультатОповещения,
	ДополнительныеПараметры = Неопределено, Объект = Неопределено)

	Если ДополнительныеПараметры <> "ГОА_ВыборСтадии" Или Не ГОА_ИспользуетсяПолеСтадии(Форма) Тогда
		Возврат ПродолжитьВызов(Форма, РезультатОповещения, ДополнительныеПараметры, Объект);
	КонецЕсли;

	Стадия = Форма.ГОА_ОтображаемаяСтадия;
	Если Не ЗначениеЗаполнено(Стадия) Тогда
		// Штатная форма следом обновит параметры выбора и восстановит текущую стадию.
		Возврат Истина;
	КонецЕсли;

	ЗаказНаряд = Форма.Объект;
	ГОА_ДанныеЗаказНаряда.ПрименитьСтадию(ЗаказНаряд, Стадия);
	Форма.Модифицированность = Истина;

	// Сохраняем штатный расчет для перехода в состояние «Выполнен».
	Если ЗаказНаряд.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен
		И ЗаказНаряд.СписаниеТоваровПоСебестоимости
		И ЗаказНаряд.Товары.Количество() > 0 Тогда
		Документы.ЗаказНаряд.ЗаполнитьТоварыПоСебестоимости(
			ЗаказНаряд, ЗаказНаряд.СписаниеТоваровПоСебестоимостиВключатьНДС);
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Стоимость деталей по заказ-наряду заполнена в соответствии с себестоимостью.'"));
	КонецЕсли;

	Возврат Истина;

КонецФункции

&После("НастроитьПараметрыВыбораЭлементовФормы")
Процедура ГОА_ОбновитьОтображаемуюСтадию(Форма, Объект = Неопределено)

	Если ГОА_ИспользуетсяПолеСтадии(Форма) Тогда
		Форма.ГОА_ОтображаемаяСтадия = ГОА_ДанныеЗаказНаряда.СтадияЗаказНаряда(
			Форма.Объект.Состояние, Форма.Объект.ГОА_Стадия, Форма.Объект.ГОА_Местонахождение);
	КонецЕсли;

КонецПроцедуры

Функция ГОА_ИспользуетсяПолеСтадии(Форма)

	Если Форма.ИмяФормы <> "Документ.ЗаказНаряд.Форма.ФормаДокумента" Тогда
		Возврат Ложь;
	КонецЕсли;

	ПолеСостояния = Форма.Элементы.Найти("Состояние");
	Возврат ПолеСостояния <> Неопределено И ПолеСостояния.ПутьКДанным = "ГОА_ОтображаемаяСтадия";

КонецФункции

#КонецОбласти
